{
  "name": "s-sftp",
  "displayName": "s-sftp",
  "description": "SFTP upload and download with private key only, configured via .vscode/sftp.json",
  "version": "0.3.5",
  "publisher": "ssigno",
  "icon": "resources/icon.png",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sSftp.init",
        "title": "Create sftp.json",
        "category": "s-sftp"
      },
      {
        "command": "sSftp.upload",
        "title": "Upload to server",
        "category": "s-sftp"
      },
      {
        "command": "sSftp.download",
        "title": "Download from server",
        "category": "s-sftp",
        "icon": "$(cloud-download)"
      },
      {
        "command": "sSftp.sync",
        "title": "Sync with server",
        "category": "s-sftp",
        "icon": "$(sync)"
      },
      {
        "command": "sSftp.syncUp",
        "title": "Sync: Local -> Server",
        "category": "s-sftp"
      },
      {
        "command": "sSftp.syncDown",
        "title": "Sync: Local <- Server",
        "category": "s-sftp"
      },
      {
        "command": "sSftp.refresh",
        "title": "Refresh Remote Tree",
        "category": "s-sftp",
        "icon": "$(refresh)"
      },
      {
        "command": "sSftp.showLog",
        "title": "Show Log",
        "category": "s-sftp"
      },
      {
        "command": "sSftp.deleteRemote",
        "title": "Delete Remote",
        "category": "s-sftp",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "sSftp.upload",
          "when": "sSftp.active",
          "group": "sSftp@1"
        },
        {
          "command": "sSftp.download",
          "when": "sSftp.active",
          "group": "sSftp@2"
        },
        {
          "command": "sSftp.syncUp",
          "when": "sSftp.active && explorerResourceIsFolder",
          "group": "sSftp@3"
        },
        {
          "command": "sSftp.syncDown",
          "when": "sSftp.active && explorerResourceIsFolder",
          "group": "sSftp@4"
        }
      ],
      "editor/context": [
        {
          "command": "sSftp.upload",
          "when": "sSftp.active",
          "group": "sSftp@1"
        }
      ],
      "view/item/context": [
        {
          "command": "sSftp.download",
          "when": "view == sSftpRemote",
          "group": "inline"
        },
        {
          "command": "sSftp.download",
          "when": "view == sSftpRemote",
          "group": "1_transfer"
        },
        {
          "command": "sSftp.deleteRemote",
          "when": "view == sSftpRemote",
          "group": "inline"
        },
        {
          "command": "sSftp.deleteRemote",
          "when": "view == sSftpRemote",
          "group": "9_delete"
        }
      ],
      "view/title": [
        {
          "command": "sSftp.sync",
          "when": "view == sSftpRemote",
          "group": "navigation"
        },
        {
          "command": "sSftp.refresh",
          "when": "view == sSftpRemote",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sSftp",
          "title": "s-sftp",
          "icon": "resources/sftp.svg"
        }
      ]
    },
    "views": {
      "sSftp": [
        {
          "id": "sSftpRemote",
          "name": "Remote Files",
          "when": "sSftp.hasConfig"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sSftpRemote",
        "contents": "Invalid sftp.json: see Output > s-sftp.\n[Create sftp.json](command:sSftp.init)",
        "when": "!sSftp.active"
      }
    ],
    "keybindings": [
      {
        "command": "sSftp.deleteRemote",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == sSftpRemote"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "package": "npm run typecheck && npm run build && vsce package"
  },
  "dependencies": {
    "minimatch": "^9.0.5",
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ssh2-sftp-client": "^9.0.4",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  }
}
